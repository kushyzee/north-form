# Supabase — Project Settings > Data API
# Safe to expose: these are public/publishable keys protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Never expose to the client, use in servers only
SUPABASE_SECRET_KEY=sb_secret_key


# Mailgun — server-side only. NEVER prefix these with NEXT_PUBLIC_.
# Used for the order-confirmation email. All three are required; the send is
# skipped (the order still succeeds) when any is missing. Read only from
# Server Components / Route Handlers — see lib/email/.
MAILGUN_API_KEY=key-00000000000000000000000000000000
MAILGUN_DOMAIN=mg.example.ng
MAILGUN_FROM_EMAIL=orders@mg.example.ng
MAILGUN_FROM_NAME=North & Form
